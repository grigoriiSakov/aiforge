{
  "name": "aiforge",
  "version": "0.1.0",
  "private": false,
  "description": "Opinionated CLI for installing AI-agent workflow surfaces in real repositories.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grigoriiSakov/aiforge.git"
  },
  "bugs": {
    "url": "https://github.com/grigoriiSakov/aiforge/issues"
  },
  "homepage": "https://github.com/grigoriiSakov/aiforge#readme",
  "keywords": [
    "ai-agents",
    "codex",
    "cursor",
    "claude",
    "workflow",
    "copier",
    "taskfile",
    "cli"
  ],
  "bin": {
    "aiforge": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "template",
    "profiles",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/ensure-bin-permissions.mjs",
    "dev": "tsx src/cli/index.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
