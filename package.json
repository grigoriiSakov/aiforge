{
  "name": "aiforge",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "aiforge": "./dist/src/cli/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
