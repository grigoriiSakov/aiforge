#!/usr/bin/env node

import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";

const DEFAULT_WORKTREE_ROOT = "{{ orchestrator_worktree_root }}";
const DEFAULT_BRANCH_PREFIX = "{{ orchestrator_branch_prefix }}";
const MAX_REVIEW_ITERATIONS = {{ orchestrator_max_review_iterations }};

const ACTIVE_SCOPE_HOLDER_STATUSES = new Set([
  "reserved",
  "building",
  "testing",
  "reviewing",
  "fix-loop",
  "pre-finalize",
  "awaiting-human-approval",
  "awaiting-finalize"
]);
const PENDING_STATUSES = new Set(["queued", "blocked-by-conflict"]);
const FLOW_COMPLETE_STATUSES = new Set(["done"]);
const HUMAN_GATE_STATUSES = new Set(["awaiting-human-approval"]);
const REVIEW_RESULTS = new Set(["clean", "low", "medium", "high", "critical"]);
const BLOCKING_REVIEW_RESULTS = new Set(["medium", "high", "critical"]);
const TEST_SCOPES = new Set(["scoped", "full"]);
const MODEL_HINT_SKIP = new Set(["auto", "default", "none", ""]);
const AGENT_RUNTIME_IDS = ["cursor", "codex", "claude", "agent", "agents"];
const CURSOR_ONLY_SLUG = /^(auto|composer[\w.-]*|gpt-5\.5-(medium|fast)|claude-opus-4-8-thinking-high)$/i;
const CODEX_ONLY_SLUG = /^gpt-5\.3-codex/i;
const PROCESS_LAYER_PREFIXES = [".ai/", ".cursor/", ".codex/", ".claude/", ".agent/", ".agents/"];
const PROCESS_LAYER_FILES = new Set(["ai.config.yaml", "AGENTS.md", "MANIFESTO.md", "Taskfile.yml"]);
const ALLOWED_STATUS_TRANSITIONS = {
  submitted: new Set(["reserved", "queued", "blocked-by-conflict", "aborted"]),
  reserved: new Set(["building", "testing", "aborted"]),
  building: new Set(["building", "testing", "reviewing", "fix-loop", "aborted"]),
  testing: new Set(["testing", "reviewing", "fix-loop", "aborted"]),
  reviewing: new Set(["reviewing", "fix-loop", "pre-finalize", "awaiting-human-approval", "aborted"]),
  "fix-loop": new Set(["fix-loop", "building", "testing", "reviewing", "awaiting-human-approval", "aborted"]),
  "pre-finalize": new Set(["pre-finalize", "testing", "awaiting-finalize", "awaiting-human-approval", "aborted"]),
  "awaiting-human-approval": new Set([
    "awaiting-human-approval",
    "fix-loop",
    "building",
    "aborted",
    "awaiting-finalize"
  ]),
  "awaiting-finalize": new Set(["fix-loop", "awaiting-finalize", "done", "aborted"]),
  queued: new Set(["queued", "reserved", "blocked-by-conflict", "aborted"]),
  "blocked-by-conflict": new Set(["blocked-by-conflict", "queued", "reserved", "aborted"]),
  done: new Set(["done"]),
  aborted: new Set(["aborted"])
};

function repoRoot() {
  return process.cwd();
}

function runtimeRoot() {
  return path.join(repoRoot(), ".ai", "runtime");
}

function orchestratorRoot() {
  return path.join(runtimeRoot(), "orchestrator");
}

function runsDir() {
  return path.join(orchestratorRoot(), "runs");
}

function registryPath() {
  return path.join(orchestratorRoot(), "registry.json");
}

function ensureDir(targetPath) {
  fs.mkdirSync(targetPath, { recursive: true });
}

function ensureStateDirs() {
  ensureDir(runsDir());
}

function utcNow() {
  return new Date().toISOString();
}

function expandHome(targetPath) {
  if (!targetPath.startsWith("~/")) {
    return targetPath;
  }
  return path.join(os.homedir(), targetPath.slice(2));
}

function readJson(filePath, fallback) {
  if (!fs.existsSync(filePath)) {
    return fallback;
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8"));
}

function writeJson(filePath, payload) {
  ensureDir(path.dirname(filePath));
  fs.writeFileSync(filePath, `${JSON.stringify(payload, null, 2)}\n`);
}

function defaultRegistry() {
  return {
    version: 1,
    updatedAt: utcNow(),
    worktreeRoot: expandHome(DEFAULT_WORKTREE_ROOT),
    branchPrefix: DEFAULT_BRANCH_PREFIX,
    activeReservations: {},
    queue: [],
    blocked: {},
    runs: {}
  };
}

function loadRegistry() {
  ensureStateDirs();
  if (!fs.existsSync(registryPath())) {
    const registry = defaultRegistry();
    saveRegistry(registry);
    return registry;
  }
  return readJson(registryPath(), defaultRegistry());
}

function saveRegistry(registry) {
  registry.updatedAt = utcNow();
  writeJson(registryPath(), registry);
}

function runPath(issueId) {
  return path.join(runsDir(), `${issueId}.json`);
}

function loadRun(issueId) {
  return readJson(runPath(issueId), null);
}

function saveRun(run) {
  run.updatedAt = utcNow();
  writeJson(runPath(run.issueId), run);
}

function normalizePath(rawValue) {
  return String(rawValue).replaceAll("\\", "/").replace(/\/+/g, "/").replace(/\/$/, "").trim();
}

function openSpecChangeId(issueId) {
  return String(issueId).trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

function dedupe(values) {
  return [...new Set(values.map((item) => String(item).trim()).filter(Boolean))];
}

function isProcessLayerPath(claimPath) {
  const normalized = normalizePath(claimPath);
  return PROCESS_LAYER_FILES.has(normalized) || PROCESS_LAYER_PREFIXES.some((prefix) => normalized.startsWith(prefix));
}

function isFileLevelClaim(claimPath) {
  const normalized = normalizePath(claimPath);
  if (!normalized) {
    return false;
  }

  const absolutePath = path.join(repoRoot(), normalized);
  if (fs.existsSync(absolutePath)) {
    return fs.statSync(absolutePath).isFile();
  }

  const baseName = path.posix.basename(normalized);
  return baseName.includes(".") || PROCESS_LAYER_FILES.has(baseName);
}

function parseScope(rawScope) {
  const scope = {
    areas: dedupe(Array.isArray(rawScope?.areas) ? rawScope.areas : []),
    paths: dedupe(Array.isArray(rawScope?.paths) ? rawScope.paths.map(normalizePath) : []),
    sharedSurfaces: dedupe(
      Array.isArray(rawScope?.shared_surfaces) ? rawScope.shared_surfaces.map(normalizePath) : []
    ),
    relatedIssues: dedupe(Array.isArray(rawScope?.related_issues) ? rawScope.related_issues : []),
    touchesProcessLayer: Boolean(rawScope?.touches_process_layer)
  };

  if (scope.paths.length === 0 && scope.sharedSurfaces.length === 0) {
    throw new Error("claimed_write_scope must contain at least one file in paths/shared_surfaces");
  }

  const invalidClaims = [...scope.paths, ...scope.sharedSurfaces].filter((claimPath) => !isFileLevelClaim(claimPath));
  if (invalidClaims.length > 0) {
    throw new Error(`scope claims must be file-level exact: ${invalidClaims.join(", ")}`);
  }

  if (scope.touchesProcessLayer) {
    const processClaims = [...scope.paths, ...scope.sharedSurfaces].filter(isProcessLayerPath);
    if (processClaims.length === 0) {
      throw new Error(
        "touches_process_layer=true requires at least one claimed file in .ai/.cursor/.codex/.claude/.agent/.agents or root process files"
      );
    }
  }

  return scope;
}

function scopeToJson(scope) {
  return {
    areas: scope.areas,
    paths: scope.paths,
    shared_surfaces: scope.sharedSurfaces,
    related_issues: scope.relatedIssues,
    touches_process_layer: scope.touchesProcessLayer
  };
}

function buildRun(issueId, scope, existingRun = null, overrides = {}) {
  return {
    issueId,
    status: overrides.status ?? existingRun?.status ?? "submitted",
    branch: overrides.branch ?? existingRun?.branch ?? `${DEFAULT_BRANCH_PREFIX}${issueId.toLowerCase()}`,
    baseBranch:
      overrides.baseBranch !== undefined ? overrides.baseBranch : (existingRun?.baseBranch ?? null),
    worktreePath: overrides.worktreePath ?? existingRun?.worktreePath ?? null,
    claimedWriteScope: scopeToJson(scope),
    currentStep: overrides.currentStep ?? existingRun?.currentStep ?? "awaiting-admission",
    conflictsWith: overrides.conflictsWith ?? existingRun?.conflictsWith ?? [],
    reviewIteration: overrides.reviewIteration ?? existingRun?.reviewIteration ?? 0,
    afterFixRereviewHint:
      overrides.afterFixRereviewHint ?? existingRun?.afterFixRereviewHint ?? null,
    lastFixResolution:
      overrides.lastFixResolution ?? existingRun?.lastFixResolution ?? null,
    lastTestScope: overrides.lastTestScope ?? existingRun?.lastTestScope ?? null,
    lastTestResult: overrides.lastTestResult ?? existingRun?.lastTestResult ?? null,
    lastTestFingerprint: overrides.lastTestFingerprint ?? existingRun?.lastTestFingerprint ?? null,
    lastLintScope: overrides.lastLintScope ?? existingRun?.lastLintScope ?? null,
    lastLintResult: overrides.lastLintResult ?? existingRun?.lastLintResult ?? null,
    lastLintFingerprint: overrides.lastLintFingerprint ?? existingRun?.lastLintFingerprint ?? null,
    lastReviewResult: overrides.lastReviewResult ?? existingRun?.lastReviewResult ?? null,
    lastReviewFingerprint: overrides.lastReviewFingerprint ?? existingRun?.lastReviewFingerprint ?? null,
    submittedAt: existingRun?.submittedAt ?? utcNow(),
    updatedAt: utcNow()
  };
}

function updateRegistryForRun(registry, run) {
  registry.runs[run.issueId] = {
    status: run.status,
    branch: run.branch,
    worktreePath: run.worktreePath,
    currentStep: run.currentStep,
    conflictsWith: run.conflictsWith,
    updatedAt: run.updatedAt
  };
}

function pathOverlap(leftPath, rightPath) {
  return normalizePath(leftPath) === normalizePath(rightPath);
}

function collectConflicts(issueId, incomingScope, registry) {
  const conflicts = [];
  for (const otherIssueId of Object.keys(registry.activeReservations ?? {})) {
    if (otherIssueId === issueId) {
      continue;
    }

    const otherRun = loadRun(otherIssueId);
    if (!otherRun) {
      continue;
    }

    const otherScope = parseScope(otherRun.claimedWriteScope);
    const directOverlap =
      incomingScope.paths.some((left) => otherScope.paths.some((right) => pathOverlap(left, right))) ||
      incomingScope.paths.some((left) => otherScope.sharedSurfaces.some((right) => pathOverlap(left, right))) ||
      incomingScope.sharedSurfaces.some((left) => otherScope.paths.some((right) => pathOverlap(left, right))) ||
      incomingScope.sharedSurfaces.some((left) => otherScope.sharedSurfaces.some((right) => pathOverlap(left, right)));
    const related =
      incomingScope.relatedIssues.includes(otherIssueId) || otherScope.relatedIssues.includes(issueId);

    if (directOverlap) {
      conflicts.push({ issueId: otherIssueId, relation: "hard-conflict" });
      continue;
    }

    if (related) {
      conflicts.push({ issueId: otherIssueId, relation: "related-conflict" });
    }
  }

  return conflicts;
}

function requireTransition(currentStatus, nextStatus) {
  const allowedTargets = ALLOWED_STATUS_TRANSITIONS[currentStatus] ?? new Set([nextStatus]);
  if (!allowedTargets.has(nextStatus)) {
    throw new Error(`invalid orchestrator transition: ${currentStatus} -> ${nextStatus}`);
  }
}

function runGit(args, cwd = repoRoot(), allowFailure = false) {
  const result = spawnSync("git", args, {
    cwd,
    encoding: "utf8"
  });
  if (!allowFailure && result.status !== 0) {
    throw new Error(result.stderr.trim() || result.stdout.trim() || `git ${args.join(" ")} failed`);
  }
  return result;
}

function gitOutput(args, cwd = repoRoot(), allowFailure = false) {
  return (runGit(args, cwd, allowFailure).stdout ?? "").trim();
}

function resolveStartPoint(baseBranch) {
  const remoteBranch = `origin/${baseBranch}`;
  if (runGit(["rev-parse", "--verify", remoteBranch], repoRoot(), true).status === 0) {
    return remoteBranch;
  }
  if (runGit(["rev-parse", "--verify", baseBranch], repoRoot(), true).status === 0) {
    return baseBranch;
  }
  return "HEAD";
}

/** Branch or symbolic ref name for the main checkout, or "HEAD" when detached. */
function currentCheckoutStartName() {
  const sym = gitOutput(["symbolic-ref", "-q", "--short", "HEAD"], repoRoot(), true);
  return sym || "HEAD";
}

function currentWorkspaceFingerprint(run) {
  if (!run.worktreePath) {
    throw new Error("worktree is required for this step");
  }
  if (!fs.existsSync(run.worktreePath)) {
    throw new Error(`worktree not found: ${run.worktreePath}`);
  }

  const head = gitOutput(["rev-parse", "HEAD"], run.worktreePath);
  const status = gitOutput(["status", "--short"], run.worktreePath, true);
  const diff = gitOutput(["diff", "--binary", "HEAD", "--"], run.worktreePath, true);
  return JSON.stringify({ head, status, diff });
}

function requirePassingTest(run) {
  if (run.lastTestResult !== "pass") {
    throw new Error("cannot move to review without passing test evidence");
  }
  if (run.lastTestFingerprint !== currentWorkspaceFingerprint(run)) {
    throw new Error("worktree changed after the last passing test; rerun tests first");
  }
}

function requirePassingScopedValidation(run) {
  if (run.lastTestResult !== "pass" || run.lastTestScope !== "scoped") {
    throw new Error("cannot finalize scoped validation without passing scoped test evidence");
  }
  if (run.lastLintResult !== "pass" || run.lastLintScope !== "scoped") {
    throw new Error("cannot finalize scoped validation without passing scoped lint evidence");
  }
  const fingerprint = currentWorkspaceFingerprint(run);
  if (run.lastTestFingerprint !== fingerprint || run.lastLintFingerprint !== fingerprint) {
    throw new Error("worktree changed after scoped validation; rerun test and lint");
  }
}

function hasCurrentScopedValidation(run) {
  if (
    run.lastTestResult !== "pass" ||
    run.lastTestScope !== "scoped" ||
    run.lastLintResult !== "pass" ||
    run.lastLintScope !== "scoped" ||
    run.lastTestFingerprint !== run.lastLintFingerprint
  ) {
    return false;
  }

  try {
    return run.lastTestFingerprint === currentWorkspaceFingerprint(run);
  } catch {
    return false;
  }
}

function requireCleanReview(run) {
  if (!["clean", "low"].includes(run.lastReviewResult)) {
    throw new Error("cannot finalize without clean or low review evidence");
  }
  if (run.lastReviewFingerprint !== currentWorkspaceFingerprint(run)) {
    throw new Error("worktree changed after the last clean review; rerun review first");
  }
}

function reconcilePendingRuns(registry) {
  const candidateIssueIds = [
    ...(registry.queue ?? []),
    ...Object.keys(registry.blocked ?? {}).filter((issueId) => !(registry.queue ?? []).includes(issueId))
  ];
  const nextQueue = [];
  const nextBlocked = {};
  const promoted = [];

  for (const issueId of candidateIssueIds) {
    const run = loadRun(issueId);
    if (!run) {
      continue;
    }

    const scope = parseScope(run.claimedWriteScope);
    const conflicts = collectConflicts(issueId, scope, registry);
    run.conflictsWith = conflicts.map((entry) => entry.issueId);

    if (conflicts.some((entry) => entry.relation === "hard-conflict")) {
      run.status = "blocked-by-conflict";
      nextBlocked[issueId] = run.conflictsWith;
    } else if (conflicts.length > 0) {
      run.status = "queued";
      nextQueue.push(issueId);
    } else {
      run.status = "reserved";
      registry.activeReservations[issueId] = run.claimedWriteScope;
      promoted.push(issueId);
    }

    saveRun(run);
    updateRegistryForRun(registry, run);
  }

  registry.queue = nextQueue;
  registry.blocked = nextBlocked;
  return promoted;
}

function getOption(args, name, fallback = null) {
  const index = args.indexOf(name);
  if (index === -1) {
    return fallback;
  }
  return args[index + 1] ?? fallback;
}

function requireOption(args, name) {
  const value = getOption(args, name, null);
  if (!value) {
    throw new Error(`missing required option: ${name}`);
  }
  return value;
}

function commandInit() {
  ensureStateDirs();
  const registry = loadRegistry();
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(registry, null, 2)}\n`);
}

function commandSubmit(args) {
  const issueId = requireOption(args, "--issue");
  const scope = parseScope(JSON.parse(requireOption(args, "--scope-json")));
  const baseBranchIdx = args.indexOf("--base-branch");
  let baseBranchPatch = {};
  if (baseBranchIdx !== -1) {
    const value = args[baseBranchIdx + 1];
    if (!value || String(value).startsWith("--")) {
      throw new Error("missing value for --base-branch");
    }
    baseBranchPatch = { baseBranch: value };
  }
  const branch = getOption(args, "--branch", `${DEFAULT_BRANCH_PREFIX}${issueId.toLowerCase()}`);
  const registry = loadRegistry();

  delete registry.activeReservations[issueId];
  registry.queue = (registry.queue ?? []).filter((queuedIssueId) => queuedIssueId !== issueId);
  delete registry.blocked[issueId];

  const conflicts = collectConflicts(issueId, scope, registry);
  const run = buildRun(issueId, scope, loadRun(issueId), {
    status: "submitted",
    branch,
    ...baseBranchPatch,
    currentStep: "awaiting-admission",
    conflictsWith: conflicts.map((entry) => entry.issueId)
  });

  if (conflicts.some((entry) => entry.relation === "hard-conflict")) {
    run.status = "blocked-by-conflict";
    registry.blocked[issueId] = run.conflictsWith;
  } else if (conflicts.length > 0) {
    run.status = "queued";
    registry.queue.push(issueId);
  } else {
    run.status = "reserved";
    registry.activeReservations[issueId] = run.claimedWriteScope;
  }

  saveRun(run);
  updateRegistryForRun(registry, run);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
}

function commandRelease(args) {
  const issueId = requireOption(args, "--issue");
  const nextStatus = getOption(args, "--status", "aborted");
  const currentStep = getOption(args, "--current-step", "released");
  const removeWorktree = args.includes("--remove-worktree");
  const registry = loadRegistry();
  const run = loadRun(issueId);

  if (!run) {
    throw new Error(`unknown issue: ${issueId}`);
  }

  delete registry.activeReservations[issueId];
  registry.queue = (registry.queue ?? []).filter((queuedIssueId) => queuedIssueId !== issueId);
  delete registry.blocked[issueId];

  if (removeWorktree && run.worktreePath) {
    runGit(["worktree", "remove", "--force", run.worktreePath], repoRoot(), true);
    run.worktreePath = null;
  }

  run.status = nextStatus;
  run.currentStep = currentStep;
  run.conflictsWith = [];
  saveRun(run);
  updateRegistryForRun(registry, run);
  const promoted = reconcilePendingRuns(registry);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify({ released: issueId, promoted }, null, 2)}\n`);
}

function commandSetStatus(args) {
  const issueId = requireOption(args, "--issue");
  const nextStatus = requireOption(args, "--status");
  const currentStep = getOption(args, "--current-step", null);
  const registry = loadRegistry();
  const run = loadRun(issueId);

  if (!run) {
    throw new Error(`unknown issue: ${issueId}`);
  }

  requireTransition(run.status, nextStatus);
  if (nextStatus === "awaiting-finalize") {
    requirePassingTest(run);
    requireCleanReview(run);
  }

  run.status = nextStatus;
  if (currentStep) {
    run.currentStep = currentStep;
  }
  saveRun(run);

  if (ACTIVE_SCOPE_HOLDER_STATUSES.has(run.status)) {
    registry.activeReservations[issueId] = run.claimedWriteScope;
  } else {
    delete registry.activeReservations[issueId];
    registry.queue = (registry.queue ?? []).filter((queuedIssueId) => queuedIssueId !== issueId);
    delete registry.blocked[issueId];
    reconcilePendingRuns(registry);
  }

  updateRegistryForRun(registry, run);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
}

function commandRecordTest(args) {
  const issueId = requireOption(args, "--issue");
  const result = requireOption(args, "--result");
  const scope = getOption(args, "--scope", "scoped");
  const currentStep = getOption(args, "--current-step", null);
  const registry = loadRegistry();
  const run = loadRun(issueId);

  if (!run) {
    throw new Error(`unknown issue: ${issueId}`);
  }
  if (!["pass", "fail"].includes(result)) {
    throw new Error("record-test result must be pass or fail");
  }
  if (!TEST_SCOPES.has(scope)) {
    throw new Error("record-test --scope must be scoped or full");
  }

  run.lastTestScope = scope;
  run.lastTestResult = result;
  run.lastTestFingerprint = currentWorkspaceFingerprint(run);

  if (result === "fail" && scope === "full") {
    run.status = "awaiting-human-approval";
    run.currentStep = currentStep ?? "full-suite-failed";
  } else if (result === "fail") {
    run.status = "fix-loop";
    run.currentStep = currentStep ?? "scoped-tests-failed";
  } else if (
    scope === "scoped" &&
    run.status === "testing" &&
    run.lastLintResult === "pass" &&
    run.lastLintFingerprint === run.lastTestFingerprint
  ) {
    requirePassingScopedValidation(run);
    run.status = "pre-finalize";
    run.currentStep = currentStep ?? "run-full-verify";
  } else if (scope === "full" && run.status === "pre-finalize") {
    run.status = "awaiting-finalize";
    run.currentStep = currentStep ?? "awaiting-user-finalize";
  } else if (currentStep) {
    run.currentStep = currentStep;
  }

  saveRun(run);
  updateRegistryForRun(registry, run);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
}

function commandRecordLint(args) {
  const issueId = requireOption(args, "--issue");
  const result = requireOption(args, "--result");
  const scope = getOption(args, "--scope", "scoped");
  const currentStep = getOption(args, "--current-step", null);
  const registry = loadRegistry();
  const run = loadRun(issueId);

  if (!run) {
    throw new Error(`unknown issue: ${issueId}`);
  }
  if (!["pass", "fail"].includes(result)) {
    throw new Error("record-lint result must be pass or fail");
  }
  if (!TEST_SCOPES.has(scope)) {
    throw new Error("record-lint --scope must be scoped or full");
  }

  run.lastLintScope = scope;
  run.lastLintResult = result;
  run.lastLintFingerprint = currentWorkspaceFingerprint(run);

  if (result === "fail" && scope === "full") {
    run.status = "awaiting-human-approval";
    run.currentStep = currentStep ?? "full-lint-failed";
  } else if (result === "fail") {
    run.status = "fix-loop";
    run.currentStep = currentStep ?? "scoped-lint-failed";
  } else if (
    scope === "scoped" &&
    run.status === "testing" &&
    run.lastTestResult === "pass" &&
    run.lastTestFingerprint === run.lastLintFingerprint
  ) {
    requirePassingScopedValidation(run);
    run.status = "pre-finalize";
    run.currentStep = currentStep ?? "run-full-verify";
  } else if (scope === "full" && run.status === "pre-finalize") {
    run.status = "awaiting-finalize";
    run.currentStep = currentStep ?? "awaiting-user-finalize";
  } else if (currentStep) {
    run.currentStep = currentStep;
  }

  saveRun(run);
  updateRegistryForRun(registry, run);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
}

function commandRecordReview(args) {
  const issueId = requireOption(args, "--issue");
  const result = requireOption(args, "--result");
  const currentStep = getOption(args, "--current-step", null);
  const registry = loadRegistry();
  const run = loadRun(issueId);

  if (!run) {
    throw new Error(`unknown issue: ${issueId}`);
  }
  if (run.status !== "reviewing") {
    throw new Error(`cannot record review in status ${run.status}; move the run to reviewing first`);
  }
  if (!REVIEW_RESULTS.has(result)) {
    throw new Error(`unknown review result: ${result}`);
  }

  run.lastReviewResult = result;
  run.lastReviewFingerprint = currentWorkspaceFingerprint(run);
  const hintIdx = args.indexOf("--after-fix-rereview");
  if (hintIdx !== -1) {
    const hint = args[hintIdx + 1];
    if (!["required", "optional", "not_needed"].includes(hint)) {
      throw new Error("--after-fix-rereview must be required, optional, or not_needed");
    }
    run.afterFixRereviewHint = hint;
  }

  if (["clean", "low"].includes(result)) {
    run.status = "testing";
    run.currentStep = currentStep ?? "run-scoped-validation";
  } else if (BLOCKING_REVIEW_RESULTS.has(result)) {
    const nextIteration = Number(run.reviewIteration ?? 0) + 1;
    if (nextIteration > MAX_REVIEW_ITERATIONS) {
      run.reviewIteration = nextIteration;
      run.status = "awaiting-human-approval";
      run.currentStep =
        currentStep ??
        `fix-loop-limit-${String(MAX_REVIEW_ITERATIONS)}-ask-user`;
    } else {
      run.reviewIteration = nextIteration;
      run.status = "fix-loop";
      run.currentStep = currentStep ?? `review-fix-${String(run.reviewIteration)}`;
    }
  }

  saveRun(run);
  updateRegistryForRun(registry, run);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
}

function commandStartWorktree(args) {
  const issueId = requireOption(args, "--issue");
  const currentStep = getOption(args, "--current-step", "worktree-created");
  const registry = loadRegistry();
  const run = loadRun(issueId);

  if (!run) {
    throw new Error(`unknown issue: ${issueId}`);
  }
  if (PENDING_STATUSES.has(run.status)) {
    throw new Error(`issue ${issueId} is not reserved yet (status=${run.status})`);
  }
  if (!ACTIVE_SCOPE_HOLDER_STATUSES.has(run.status)) {
    throw new Error(`issue ${issueId} is in status ${run.status}; worktree startup is not allowed`);
  }
  if (run.worktreePath) {
    throw new Error(`worktree already exists for ${issueId}: ${run.worktreePath}`);
  }

  const worktreeRoot = expandHome(registry.worktreeRoot || DEFAULT_WORKTREE_ROOT);
  const worktreePath = path.join(worktreeRoot, issueId);
  ensureDir(worktreeRoot);
  if (fs.existsSync(worktreePath)) {
    throw new Error(`worktree path already exists: ${worktreePath}`);
  }

  const branch = run.branch || `${DEFAULT_BRANCH_PREFIX}${issueId.toLowerCase()}`;
  const startName =
    run.baseBranch != null && String(run.baseBranch).trim() !== ""
      ? run.baseBranch
      : currentCheckoutStartName();
  const startPoint = resolveStartPoint(startName);
  const branchExists = runGit(["show-ref", "--verify", "--quiet", `refs/heads/${branch}`], repoRoot(), true).status === 0;

  if (branchExists) {
    runGit(["worktree", "add", worktreePath, branch], repoRoot());
  } else {
    runGit(["worktree", "add", "-b", branch, worktreePath, startPoint], repoRoot());
  }

  run.worktreePath = worktreePath;
  run.status = "building";
  run.currentStep = currentStep;
  saveRun(run);
  updateRegistryForRun(registry, run);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
}

function commandStatus(args) {
  const issueId = getOption(args, "--issue", null);
  if (issueId) {
    const run = loadRun(issueId);
    if (!run) {
      throw new Error(`unknown issue: ${issueId}`);
    }
    process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
    return;
  }
  process.stdout.write(`${JSON.stringify(loadRegistry(), null, 2)}\n`);
}

function modelProfilesPath() {
  return path.join(repoRoot(), ".ai", "project.model-profiles.json");
}

function machineManifestPath() {
  return path.join(repoRoot(), ".ai", "project.manifest.json");
}

function isAgentRuntimeId(value) {
  return AGENT_RUNTIME_IDS.includes(String(value ?? "").toLowerCase());
}

function detectActiveRuntime() {
  const env = process.env;
  const explicit = env.AIFORGE_ACTIVE_RUNTIME?.trim().toLowerCase();
  if (explicit && isAgentRuntimeId(explicit)) {
    return explicit;
  }
  const provider = env.AIFORGE_RUNTIME_PROVIDER?.trim().toLowerCase();
  if (provider && isAgentRuntimeId(provider)) {
    return provider;
  }
  if (env.CODEX_THREAD_ID || env.CODEX_CI || env.CODEX_SANDBOX || env.CODEX_ENV || env.CODEX_ROOT) {
    return "codex";
  }
  if (env.CLAUDECODE || env.CLAUDE_CODE) {
    return "claude";
  }
  if (env.CURSOR_TRACE_ID || env.CURSOR_AGENT || env.CURSOR_SESSION_ID) {
    return "cursor";
  }
  return null;
}

function loadEnabledRuntimes() {
  const manifest = readJson(machineManifestPath(), null);
  return manifest?.runtimes ?? manifest?.enabledRuntimes ?? null;
}

function validateModelSlugForRuntime(runtime, slug) {
  const normalized = String(slug ?? "").trim();
  if (!normalized || MODEL_HINT_SKIP.has(normalized.toLowerCase())) {
    return {
      model: null,
      rejectedReason: normalized ? "reserved-ui-mode" : "no-runtime-mapping"
    };
  }
  if (
    runtime === "codex" &&
    (CURSOR_ONLY_SLUG.test(normalized) || /\bgpt-5\.5-(medium|fast)\b/i.test(normalized))
  ) {
    return {
      model: null,
      rejectedReason: `slug "${normalized}" is a Cursor-style id; configure Codex model ids under agents.runtimeModels.codex`
    };
  }
  if (runtime === "cursor" && CODEX_ONLY_SLUG.test(normalized)) {
    return {
      model: null,
      rejectedReason: `slug "${normalized}" is Codex-only; use agents.runtimeModels.cursor`
    };
  }
  return { model: normalized, rejectedReason: null };
}

function delegationInstruction(runtime, tier, model) {
  if (runtime === "cursor") {
    return model
      ? `Cursor native subagent preference: model="${model}" when the Task tool supports it. Never shell-launch another agent CLI.`
      : `Cursor native subagent: use an inherited compatible model for tier ${tier}. Never shell-launch another agent CLI.`;
  }
  if (runtime === "codex") {
    return model
      ? `Codex native subagent preference: model="${model}" when native delegation supports selection; otherwise inherit a compatible model and record the fallback. Never run codex exec or poll a PTY.`
      : `Codex native subagent: inherit a compatible model for tier ${tier}. Never read agents.runtimeModels.cursor, run codex exec, or poll a PTY.`;
  }
  if (runtime === "claude") {
    return model
      ? `Claude native subagent preference: model="${model}" when supported. Never shell-launch another agent CLI.`
      : `Claude native subagent: use an inherited compatible model for tier ${tier}. Never shell-launch another agent CLI.`;
  }
  return `Runtime ${runtime}, tier ${tier}. Use only native subagent tools and agents.runtimeModels.${runtime}.`;
}

function resolveActiveRuntime(requestedRuntime) {
  const detected = detectActiveRuntime();
  const enabled = loadEnabledRuntimes();
  const warnings = [];
  let runtime = requestedRuntime ? String(requestedRuntime).toLowerCase() : null;

  if (runtime && !isAgentRuntimeId(runtime)) {
    throw new Error(`unknown --runtime ${runtime}; expected one of: ${AGENT_RUNTIME_IDS.join(", ")}`);
  }

  if (detected && runtime && runtime !== detected) {
    warnings.push(`--runtime ${runtime} ignored; active runtime is ${detected}`);
    runtime = detected;
  } else if (!runtime) {
    runtime = detected;
  }

  if (!runtime) {
    throw new Error(
      "Cannot detect agent runtime. Export AIFORGE_ACTIVE_RUNTIME=codex|cursor|claude or pass --runtime explicitly."
    );
  }

  if (enabled && enabled[runtime] === false) {
    throw new Error(`runtime "${runtime}" is disabled in ai.config.yaml runtimes`);
  }

  return { runtime, detected, warnings };
}

function resolveModelHint(role, runtime) {
  const manifest = readJson(modelProfilesPath(), null);
  const tier = manifest?.roles?.[role]?.tier ?? null;
  const block = manifest?.runtimeModels?.[runtime] ?? {};
  const slug = tier ? block[tier] : null;
  const validated = validateModelSlugForRuntime(runtime, slug);
  return {
    role,
    runtime,
    tier,
    model: validated.model,
    configuredSlug: slug ?? null,
    skipReason: validated.rejectedReason,
    availableRuntimes: Object.keys(manifest?.runtimeModels ?? {})
  };
}

function commandActiveRuntime() {
  const detected = detectActiveRuntime();
  const enabled = loadEnabledRuntimes();
  const runtimeModels = readJson(modelProfilesPath(), null)?.runtimeModels ?? {};
  process.stdout.write(
    `${JSON.stringify(
      {
        detected,
        enabledRuntimes: enabled,
        configuredModelNamespaces: Object.keys(runtimeModels),
        hint: detected
          ? `Use model-hint without --runtime (reads agents.runtimeModels.${detected} only)`
          : "Set AIFORGE_ACTIVE_RUNTIME or run from Cursor/Codex/Claude so detection works"
      },
      null,
      2
    )}\n`
  );
}

function commandModelHint(args) {
  const role = requireOption(args, "--role");
  const requestedIdx = args.indexOf("--runtime");
  const requestedRuntime =
    requestedIdx !== -1 ? args[requestedIdx + 1] : null;
  const { runtime, detected, warnings } = resolveActiveRuntime(requestedRuntime);
  const hint = resolveModelHint(role, runtime);
  const payload = {
    ...hint,
    activeRuntime: runtime,
    detectedRuntime: detected,
    warnings,
    instruction: delegationInstruction(runtime, String(hint.tier ?? "budget"), hint.model)
  };
  process.stdout.write(`${JSON.stringify(payload, null, 2)}\n`);
}

const FIX_RESOLUTION_DECISIONS = new Set(["skip-rereview", "require-rereview"]);

function commandRecordFixResolution(args) {
  const issueId = requireOption(args, "--issue");
  const decision = requireOption(args, "--decision");
  const note = getOption(args, "--note", "");
  const registry = loadRegistry();
  const run = loadRun(issueId);

  if (!run) {
    throw new Error(`unknown issue: ${issueId}`);
  }
  if (run.status !== "fix-loop") {
    throw new Error(
      `record-fix-resolution requires status fix-loop (current: ${run.status})`
    );
  }
  if (!FIX_RESOLUTION_DECISIONS.has(decision)) {
    throw new Error("record-fix-resolution --decision must be skip-rereview or require-rereview");
  }
  if (run.lastTestResult !== "pass" || run.lastTestScope !== "scoped") {
    throw new Error(
      "record-fix-resolution requires scoped test pass first (record-test --scope scoped --result pass)"
    );
  }
  if (run.lastLintResult !== "pass" || run.lastLintScope !== "scoped") {
    throw new Error(
      "record-fix-resolution requires scoped lint pass first (record-lint --scope scoped --result pass)"
    );
  }
  requirePassingScopedValidation(run);
  if (!["clean", "low", "medium", "high", "critical"].includes(run.lastReviewResult ?? "")) {
    throw new Error(
      "record-fix-resolution applies after review or validation findings (lastReviewResult clean/low/medium/high/critical)"
    );
  }

  run.lastFixResolution = {
    decision,
    note,
    at: utcNow(),
    afterFixRereviewHint: run.afterFixRereviewHint ?? null
  };

  if (decision === "skip-rereview") {
    run.lastReviewResult = "low";
    run.lastReviewFingerprint = currentWorkspaceFingerprint(run);
    run.status = "pre-finalize";
    run.currentStep = "fix-resolved-without-rereview";
  } else {
    run.status = "reviewing";
    run.currentStep = "rereview-after-fix";
  }

  saveRun(run);
  updateRegistryForRun(registry, run);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
}

function commandApproveFixLoop(args) {
  const issueId = requireOption(args, "--issue");
  const registry = loadRegistry();
  const run = loadRun(issueId);

  if (!run) {
    throw new Error(`unknown issue: ${issueId}`);
  }
  if (run.status !== "awaiting-human-approval") {
    throw new Error(
      `approve-fix-loop requires status awaiting-human-approval (current: ${run.status})`
    );
  }

  run.status = "fix-loop";
  run.currentStep = "human-approved-fix-loop";
  saveRun(run);
  updateRegistryForRun(registry, run);
  saveRegistry(registry);
  process.stdout.write(`${JSON.stringify(run, null, 2)}\n`);
}

function orchestratorLimits(run) {
  return {
    maxReviewIterations: MAX_REVIEW_ITERATIONS,
    reviewIteration: Number(run?.reviewIteration ?? 0),
    reviewIterationsRemaining: Math.max(
      0,
      MAX_REVIEW_ITERATIONS - Number(run?.reviewIteration ?? 0)
    )
  };
}

function commandGraphNext(args) {
  const issueId = args[2] ?? null;
  if (!issueId) {
    throw new Error("graph next requires ISSUE-ID");
  }

  const run = loadRun(issueId);
  const limits = orchestratorLimits(run);
  let payload;

  if (!run) {
    payload = {
      step: "pending",
      action: "run_plan",
      issue: issueId,
      message: "No orchestrator run exists yet. Create a plan with Claimed Write Scope first."
    };
  } else if (run.status === "reserved" && !run.worktreePath) {
    payload = {
      step: "pending",
      action: "start_worktree",
      issue: issueId,
      worktreeRoot: expandHome(DEFAULT_WORKTREE_ROOT),
      ...limits
    };
  } else if (run.status === "pre-finalize") {
    payload = {
      step: "pending",
      action: "run_full_verify",
      issue: issueId,
      worktreePath: run.worktreePath,
      testScope: "full",
      message:
        "Review gate passed. Run full project verify once, then record-test --scope full.",
      ...limits
    };
  } else if (run.status === "awaiting-finalize") {
    payload = {
      step: "pending",
      action: "finalize_openspec",
      issue: issueId,
      changeId: openSpecChangeId(issueId),
      worktreePath: run.worktreePath,
      message: "Sync and archive the validated OpenSpec change, then release the run as done.",
      ...limits
    };
  } else if (HUMAN_GATE_STATUSES.has(run.status)) {
    payload = {
      step: "human_gate",
      action: "await_human_decision",
      issue: issueId,
      worktreePath: run.worktreePath,
      currentStep: run.currentStep,
      message:
        "Stop automation. Ask the user what to do next. To resume fix-loop after approval: approve-fix-loop.",
      ...limits
    };
  } else if (run.status === "fix-loop" && hasCurrentScopedValidation(run)) {
    payload = {
      step: "pending",
      action: "decide_fix_loop",
      issue: issueId,
      worktreePath: run.worktreePath,
      lastReviewResult: run.lastReviewResult,
      afterFixRereviewHint: run.afterFixRereviewHint,
      message:
        "Scoped tests and lint passed after fix. Read review findings + diff; choose skip-rereview or require-rereview (see orchestrator-fix-loop-decision.md). Do not auto-launch review subagent.",
      ...limits
    };
  } else if (run.status === "testing") {
    payload = {
      step: "pending",
      action: "run_scoped_validation",
      issue: issueId,
      worktreePath: run.worktreePath,
      testScope: "scoped",
      lintScope: "scoped",
      message: "Run scoped tests and lint after review; record both as pass before full verification.",
      ...limits
    };
  } else if (run.status === "building") {
    payload = {
      step: "pending",
      action: "run_implementation",
      issue: issueId,
      worktreePath: run.worktreePath,
      message: "Complete implementation, then move directly to reviewing; do not run pre-review tests or lint.",
      ...limits
    };
  } else if (
    run.status === "fix-loop" &&
    ((run.lastTestResult === "pass" && run.lastTestScope === "scoped") ||
      (run.lastLintResult === "pass" && run.lastLintScope === "scoped"))
  ) {
    payload = {
      step: "pending",
      action: "run_scoped_validation",
      issue: issueId,
      worktreePath: run.worktreePath,
      testScope: "scoped",
      lintScope: "scoped",
      message: "Finish the missing scoped test or lint check before resolving the fix loop.",
      ...limits
    };
  } else if (run.status === "fix-loop") {
    payload = {
      step: "pending",
      action: "run_implementation_fix",
      issue: issueId,
      worktreePath: run.worktreePath,
      message: "Apply review findings, then run scoped tests and lint until both are green.",
      ...limits
    };
  } else if (run.status === "reviewing") {
    payload = {
      step: "pending",
      action: "run_review",
      issue: issueId,
      worktreePath: run.worktreePath,
      testScope: run.lastTestScope ?? "scoped",
      ...limits
    };
  } else if (PENDING_STATUSES.has(run.status) || run.status === "aborted") {
    payload = {
      step: "waiting_conflict",
      issue: issueId,
      status: run.status,
      conflictsWith: run.conflictsWith
    };
  } else if (FLOW_COMPLETE_STATUSES.has(run.status)) {
    payload = {
      step: "flow_complete",
      issue: issueId,
      status: run.status,
      worktreePath: run.worktreePath
    };
  } else {
    payload = {
      step: "blocked",
      issue: issueId,
      status: run.status,
      currentStep: run.currentStep
    };
  }

  process.stdout.write(`${JSON.stringify(payload, null, 2)}\n`);
}

function commandWorktreeEnv(args) {
  const issueId = requireOption(args, "--issue");
  const run = loadRun(issueId);
  if (!run?.worktreePath) {
    throw new Error(`issue ${issueId} does not have an orchestrator worktree yet`);
  }
  process.stdout.write(`export AIFORGE_WORKTREE_PATH=${JSON.stringify(run.worktreePath)}\n`);
}

function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  switch (command) {
    case "init":
      commandInit();
      return;
    case "submit":
      commandSubmit(args);
      return;
    case "release":
      commandRelease(args);
      return;
    case "set-status":
      commandSetStatus(args);
      return;
    case "record-test":
      commandRecordTest(args);
      return;
    case "record-lint":
      commandRecordLint(args);
      return;
    case "record-review":
      commandRecordReview(args);
      return;
    case "start-worktree":
      commandStartWorktree(args);
      return;
    case "status":
      commandStatus(args);
      return;
    case "worktree-env":
      commandWorktreeEnv(args);
      return;
    case "graph":
      if (args[1] !== "next") {
        throw new Error("supported graph subcommand: next");
      }
      commandGraphNext(args);
      return;
    case "active-runtime":
      commandActiveRuntime();
      return;
    case "model-hint":
      commandModelHint(args);
      return;
    case "record-fix-resolution":
      commandRecordFixResolution(args);
      return;
    case "approve-fix-loop":
      commandApproveFixLoop(args);
      return;
    default:
      throw new Error(`unknown orchestrator command: ${String(command ?? "")}`);
  }
}

try {
  main();
} catch (error) {
  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exit(2);
}
