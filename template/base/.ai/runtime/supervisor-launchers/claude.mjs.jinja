#!/usr/bin/env node

import { spawnSync } from "node:child_process";
import path from "node:path";

function launch(args) {
  const bin = process.env.AIFORGE_SUPERVISOR_CLAUDE_BIN ?? process.env.AIFORGE_SUPERVISOR_HEADLESS_BIN;
  if (!bin) {
    throw new Error("Missing claude supervisor launcher. Set AIFORGE_SUPERVISOR_CLAUDE_BIN.");
  }
  const headlessPath = path.join(process.cwd(), ".ai", "runtime", "supervisor-launchers", "headless.mjs");
  const env = {
    ...process.env,
    AIFORGE_SUPERVISOR_HEADLESS_BIN: bin
  };
  const result = spawnSync("node", [headlessPath, ...args], {
    cwd: process.cwd(),
    encoding: "utf8",
    env
  });
  if (result.status !== 0) {
    throw new Error(result.stderr || result.stdout || "claude supervisor launcher failed");
  }
  process.stdout.write(result.stdout);
}

function main() {
  const args = process.argv.slice(2);
  const command = args[0];
  switch (command) {
    case "launch":
      launch(args);
      return;
    default:
      throw new Error(`unknown claude supervisor launcher command: ${String(command ?? "")}`);
  }
}

main();
