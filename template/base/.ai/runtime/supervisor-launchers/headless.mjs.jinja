#!/usr/bin/env node

import { spawnSync } from "node:child_process";

function getOption(args, name, fallback = null) {
  const index = args.indexOf(name);
  if (index === -1) {
    return fallback;
  }
  return args[index + 1] ?? fallback;
}

function requireOption(args, name) {
  const value = getOption(args, name, null);
  if (!value) {
    throw new Error(`missing required option: ${name}`);
  }
  return value;
}

function launch(args) {
  const role = requireOption(args, "--role");
  const slug = requireOption(args, "--slug");
  const issue = requireOption(args, "--issue");
  const contextFile = requireOption(args, "--context-file");
  const bin =
    process.env.AIFORGE_SUPERVISOR_HEADLESS_BIN ??
    process.env.AIFORGE_SUPERVISOR_LAUNCHER_BIN ??
    process.env.AIFORGE_SUPERVISOR_AGENT_BIN;

  if (!bin) {
    throw new Error(
      "Missing headless supervisor launcher. Set AIFORGE_SUPERVISOR_HEADLESS_BIN (or AIFORGE_SUPERVISOR_LAUNCHER_BIN)."
    );
  }

  const result = spawnSync(
    bin,
    ["--role", role, "--slug", slug, "--issue", issue, "--context-file", contextFile, "--repo", process.cwd()],
    {
      cwd: process.cwd(),
      encoding: "utf8",
      env: process.env
    }
  );

  if (result.status !== 0) {
    throw new Error(result.stderr || result.stdout || `headless supervisor launcher failed for ${issue}`);
  }

  const stdout = result.stdout.trim();
  const payload = stdout ? JSON.parse(stdout) : {};
  process.stdout.write(
    `${JSON.stringify(
      {
        launcher: "headless",
        runId: payload.runId ?? `${role}-${issue}-${Date.now()}`,
        ...payload
      },
      null,
      2
    )}\n`
  );
}

function main() {
  const args = process.argv.slice(2);
  const command = args[0];
  switch (command) {
    case "launch":
      launch(args);
      return;
    default:
      throw new Error(`unknown supervisor headless launcher command: ${String(command ?? "")}`);
  }
}

main();
