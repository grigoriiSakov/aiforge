#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";

function repoRoot() {
  return process.cwd();
}

function runtimeRoot() {
  return path.join(repoRoot(), ".ai", "runtime", "supervisor");
}

function importsDir() {
  return path.join(runtimeRoot(), "imports");
}

function ensureDir(targetPath) {
  fs.mkdirSync(targetPath, { recursive: true });
}

function readJson(filePath) {
  if (!fs.existsSync(filePath)) {
    throw new Error(`missing file: ${filePath}`);
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8"));
}

function writeJson(filePath, payload) {
  ensureDir(path.dirname(filePath));
  fs.writeFileSync(filePath, `${JSON.stringify(payload, null, 2)}\n`, "utf8");
}

function getOption(args, name, fallback = null) {
  const index = args.indexOf(name);
  if (index === -1) {
    return fallback;
  }
  return args[index + 1] ?? fallback;
}

function requireOption(args, name) {
  const value = getOption(args, name, null);
  if (!value) {
    throw new Error(`missing required option: ${name}`);
  }
  return value;
}

function defaultManifestPath(slug) {
  return path.join(repoRoot(), ".ai", "context", "initiatives", slug, "issues-manifest.json");
}

function normalizeBlockedBy(value) {
  if (!Array.isArray(value)) {
    return [];
  }
  return [...new Set(value.map((entry) => String(entry).trim()).filter(Boolean))];
}

function normalizeIssue(rawIssue, index) {
  const id = String(rawIssue?.id ?? "").trim();
  if (!id) {
    throw new Error(`issue at index ${String(index)} is missing id`);
  }
  return {
    id,
    title: String(rawIssue?.title ?? id).trim() || id,
    order: Number.isFinite(rawIssue?.order) ? Number(rawIssue.order) : (index + 1) * 10,
    blockedBy: normalizeBlockedBy(rawIssue?.blockedBy ?? rawIssue?.blocked_by),
    ...(String(rawIssue?.team ?? rawIssue?.ownerTeam ?? rawIssue?.owner_team ?? "").trim()
      ? { team: String(rawIssue.team ?? rawIssue.ownerTeam ?? rawIssue.owner_team).trim().toLowerCase() }
      : {})
  };
}

function normalizeSnapshot(slug, rawSnapshot, sourcePath) {
  const manifest = rawSnapshot?.manifest && typeof rawSnapshot.manifest === "object" ? rawSnapshot.manifest : rawSnapshot;
  if (!manifest || typeof manifest !== "object" || Array.isArray(manifest)) {
    throw new Error(`invalid supervisor source snapshot: ${sourcePath}`);
  }

  const rawIssues = Array.isArray(manifest.issues) ? manifest.issues : [];
  if (rawIssues.length === 0) {
    throw new Error(`supervisor source must contain at least one issue: ${sourcePath}`);
  }

  const issues = rawIssues.map((entry, index) => normalizeIssue(entry, index));
  issues.sort((left, right) => left.order - right.order || left.id.localeCompare(right.id));

  const issueIds = new Set(issues.map((issue) => issue.id));
  for (const issue of issues) {
    const missing = issue.blockedBy.filter((entry) => !issueIds.has(entry));
    if (missing.length > 0) {
      throw new Error(`issue ${issue.id} depends on unknown issues: ${missing.join(", ")}`);
    }
  }

  return {
    version: Number.isFinite(manifest.version) ? Number(manifest.version) : 1,
    slug: String(manifest.slug ?? slug).trim() || slug,
    baseBranch: normalizeOptionalString(manifest.baseBranch ?? manifest.base_branch),
    managerBranch:
      String(manifest.managerBranch ?? manifest.manager_branch ?? `supervisor/${slug}`).trim() || `supervisor/${slug}`,
    maxAttemptsPerIssue: Number.isInteger(manifest.maxAttemptsPerIssue ?? manifest.max_attempts_per_issue)
      ? Number(manifest.maxAttemptsPerIssue ?? manifest.max_attempts_per_issue)
      : 3,
    project: typeof manifest.project === "object" && manifest.project ? manifest.project : {},
    artifacts: typeof manifest.artifacts === "object" && manifest.artifacts ? manifest.artifacts : {},
    issues,
    source: {
      path: sourcePath,
      importedAt: new Date().toISOString(),
      kind: sourcePath.endsWith("issues-manifest.json") ? "initiative-manifest" : "tracker-snapshot"
    }
  };
}

function normalizeOptionalString(value) {
  if (typeof value !== "string") {
    return null;
  }
  const trimmed = value.trim();
  return trimmed || null;
}

function importSnapshot(args) {
  const slug = requireOption(args, "--slug");
  const sourcePath = path.resolve(
    getOption(args, "--source", getOption(args, "--manifest", defaultManifestPath(slug)))
  );
  const snapshot = normalizeSnapshot(slug, readJson(sourcePath), sourcePath);
  const targetPath = path.join(importsDir(), `${slug}.json`);
  writeJson(targetPath, snapshot);
  process.stdout.write(
    `${JSON.stringify(
      {
        slug,
        sourcePath,
        snapshotPath: path.relative(repoRoot(), targetPath).replaceAll("\\", "/"),
        issueCount: snapshot.issues.length,
        project: snapshot.project
      },
      null,
      2
    )}\n`
  );
}

function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  switch (command) {
    case "import":
      importSnapshot(args);
      return;
    default:
      throw new Error(`unknown supervisor-linear-sync command: ${String(command ?? "")}`);
  }
}

main();
