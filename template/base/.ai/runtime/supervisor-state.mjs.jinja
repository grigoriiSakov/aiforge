#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";

const DEFAULT_MANAGER_BRANCH_PREFIX = "supervisor/";
const DEFAULT_MAX_ATTEMPTS = 3;
const PLAN_PROGRESS_ROOT = "{{ plan_progress_runtime_root }}";

function repoRoot() {
  return process.cwd();
}

function runtimeRoot() {
  return path.join(repoRoot(), ".ai", "runtime");
}

function supervisorRoot() {
  return path.join(runtimeRoot(), "supervisor");
}

function runsDir() {
  return path.join(supervisorRoot(), "runs");
}

function contextDir() {
  return path.join(supervisorRoot(), "context");
}

function findingsDir() {
  return path.join(supervisorRoot(), "findings");
}

function reviewsDir() {
  return path.join(supervisorRoot(), "reviews");
}

function eventsDir() {
  return path.join(supervisorRoot(), "events");
}

function importsDir() {
  return path.join(supervisorRoot(), "imports");
}

function ensureDir(targetPath) {
  fs.mkdirSync(targetPath, { recursive: true });
}

function ensureStateDirs() {
  ensureDir(runsDir());
  ensureDir(contextDir());
  ensureDir(findingsDir());
  ensureDir(reviewsDir());
  ensureDir(eventsDir());
  ensureDir(importsDir());
}

function utcNow() {
  return new Date().toISOString();
}

function readJson(filePath, fallback = null) {
  if (!fs.existsSync(filePath)) {
    return fallback;
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8"));
}

function writeJson(filePath, payload) {
  ensureDir(path.dirname(filePath));
  fs.writeFileSync(filePath, `${JSON.stringify(payload, null, 2)}\n`, "utf8");
}

function normalizePath(input) {
  return String(input ?? "")
    .replaceAll("\\", "/")
    .replace(/\/+/g, "/")
    .replace(/\/$/, "")
    .trim();
}

function normalizeOptionalString(input) {
  if (typeof input !== "string") {
    return null;
  }
  const trimmed = input.trim();
  return trimmed || null;
}

function formatBaseBranchOverride(baseBranch) {
  return baseBranch ? String(baseBranch) : "none (use current checkout at worktree start)";
}

function getOption(args, name, fallback = null) {
  const index = args.indexOf(name);
  if (index === -1) {
    return fallback;
  }
  return args[index + 1] ?? fallback;
}

function getMultiOptionValues(args, name) {
  const values = [];
  for (let index = 0; index < args.length; index += 1) {
    if (args[index] !== name) {
      continue;
    }
    const rawValue = args[index + 1] ?? "";
    if (!rawValue || String(rawValue).startsWith("--")) {
      throw new Error(`missing value for ${name}`);
    }
    values.push(
      ...String(rawValue)
        .split(",")
        .map((entry) => entry.trim())
        .filter(Boolean)
    );
  }
  return [...new Set(values)];
}

function requireOption(args, name) {
  const value = getOption(args, name, null);
  if (!value) {
    throw new Error(`missing required option: ${name}`);
  }
  return value;
}

function slugStatePath(slug) {
  return path.join(runsDir(), `${slug}.json`);
}

function currentPath(slug) {
  return path.join(supervisorRoot(), "current", `${slug}.md`);
}

function eventLogPath(slug) {
  return path.join(eventsDir(), `${slug}.jsonl`);
}

function workerContextPath(slug, issueId, attempt) {
  return path.join(contextDir(), slug, `worker-${issueId}-attempt-${attempt}.md`);
}

function managerContextPath(slug) {
  return path.join(contextDir(), slug, "manager.md");
}

function reviewPath(slug, issueId, attempt) {
  return path.join(reviewsDir(), slug, `${issueId}-attempt-${attempt}.md`);
}

function issueFindingsPath(slug, issueId, attempt) {
  return path.join(findingsDir(), slug, `${issueId}-attempt-${attempt}.md`);
}

function orchestratorRunPath(issueId) {
  return normalizePath(path.join(".ai", "runtime", "orchestrator", "runs", `${issueId}.json`));
}

function openSpecChangeId(issueId) {
  return String(issueId).trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

function openSpecChangePath(issueId) {
  return normalizePath(path.join("openspec", "changes", openSpecChangeId(issueId)));
}

function localProgressPath(issueId) {
  return normalizePath(path.join(PLAN_PROGRESS_ROOT, issueId, "progress.md"));
}

function loadState(slug) {
  return readJson(slugStatePath(slug), null);
}

function requireState(slug) {
  const state = loadState(slug);
  if (!state) {
    throw new Error(`unknown supervisor run: ${slug}`);
  }
  return state;
}

function appendEvent(slug, payload) {
  ensureDir(eventsDir());
  fs.appendFileSync(eventLogPath(slug), `${JSON.stringify({ timestamp: utcNow(), ...payload })}\n`, "utf8");
}

function normalizeBlockedBy(blockedBy) {
  if (!Array.isArray(blockedBy)) {
    return [];
  }
  return [...new Set(blockedBy.map((entry) => String(entry).trim()).filter(Boolean))];
}

function normalizeTeam(value) {
  const normalized = String(value ?? "").trim().toLowerCase();
  return normalized || null;
}

function parseIssueManifest(rawManifest, slug, sourcePath) {
  if (!rawManifest || typeof rawManifest !== "object" || Array.isArray(rawManifest)) {
    throw new Error(`invalid supervisor source: ${sourcePath}`);
  }

  const rawIssues = Array.isArray(rawManifest.issues) ? rawManifest.issues : [];
  if (rawIssues.length === 0) {
    throw new Error(`supervisor source must contain at least one issue: ${sourcePath}`);
  }

  const seen = new Set();
  const issues = rawIssues.map((rawIssue, index) => {
    const issueId = String(rawIssue?.id ?? "").trim();
    if (!issueId) {
      throw new Error(`issue at index ${String(index)} is missing id in ${sourcePath}`);
    }
    if (seen.has(issueId)) {
      throw new Error(`duplicate issue id in supervisor source: ${issueId}`);
    }
    seen.add(issueId);
    return {
      id: issueId,
      title: String(rawIssue?.title ?? issueId).trim() || issueId,
      order: Number.isFinite(rawIssue?.order) ? Number(rawIssue.order) : index + 1,
      blockedBy: normalizeBlockedBy(rawIssue?.blockedBy ?? rawIssue?.blocked_by),
      team: normalizeTeam(rawIssue?.team ?? rawIssue?.ownerTeam ?? rawIssue?.owner_team),
      orchestrator: rawIssue?.orchestrator !== false,
      artifacts: typeof rawIssue?.artifacts === "object" && rawIssue?.artifacts ? rawIssue.artifacts : {}
    };
  });

  issues.sort((left, right) => left.order - right.order || left.id.localeCompare(right.id));

  const issueIdSet = new Set(issues.map((issue) => issue.id));
  for (const issue of issues) {
    const invalid = issue.blockedBy.filter((entry) => !issueIdSet.has(entry));
    if (invalid.length > 0) {
      throw new Error(`issue ${issue.id} depends on unknown issues: ${invalid.join(", ")}`);
    }
  }

  return {
    version: Number.isFinite(rawManifest.version) ? Number(rawManifest.version) : 1,
    slug: String(rawManifest.slug ?? slug).trim() || slug,
    baseBranch: normalizeOptionalString(rawManifest.baseBranch ?? rawManifest.base_branch),
    managerBranch:
      String(
        rawManifest.managerBranch ?? rawManifest.manager_branch ?? `${DEFAULT_MANAGER_BRANCH_PREFIX}${slug}`
      ).trim() || `${DEFAULT_MANAGER_BRANCH_PREFIX}${slug}`,
    maxAttemptsPerIssue: Number.isInteger(rawManifest.maxAttemptsPerIssue ?? rawManifest.max_attempts_per_issue)
      ? Number(rawManifest.maxAttemptsPerIssue ?? rawManifest.max_attempts_per_issue)
      : DEFAULT_MAX_ATTEMPTS,
    project: typeof rawManifest.project === "object" && rawManifest.project ? rawManifest.project : {},
    artifacts: typeof rawManifest.artifacts === "object" && rawManifest.artifacts ? rawManifest.artifacts : {},
    issues
  };
}

function selectIssues(manifest, options) {
  const selectedTeams = [...new Set((options?.teams ?? []).map(normalizeTeam).filter(Boolean))];
  const selectedIssueIds = [...new Set((options?.issueIds ?? []).map((entry) => String(entry).trim()).filter(Boolean))];
  const allIssues = manifest.issues;
  const issueIdSet = new Set(allIssues.map((issue) => issue.id));

  const missingIssueIds = selectedIssueIds.filter((issueId) => !issueIdSet.has(issueId));
  if (missingIssueIds.length > 0) {
    throw new Error(`unknown issue ids in selection: ${missingIssueIds.join(", ")}`);
  }

  const shouldInclude = (issue) => {
    if (selectedTeams.length === 0 && selectedIssueIds.length === 0) {
      return true;
    }
    return selectedIssueIds.includes(issue.id) || (issue.team ? selectedTeams.includes(issue.team) : false);
  };

  const issues = allIssues.filter(shouldInclude);
  if (issues.length === 0) {
    throw new Error(
      `supervisor selection matched no issues (teams=${selectedTeams.join(",") || "none"}, issues=${selectedIssueIds.join(",") || "none"})`
    );
  }

  const selectedIds = new Set(issues.map((issue) => issue.id));
  const filteredIssues = issues.map((issue) => ({
    ...issue,
    blockedBy: issue.blockedBy.filter((entry) => selectedIds.has(entry)),
    externalBlockedBy: issue.blockedBy.filter((entry) => !selectedIds.has(entry))
  }));

  return {
    teams: selectedTeams,
    issueIds: selectedIssueIds,
    selectedIssueCount: filteredIssues.length,
    issues: filteredIssues
  };
}

function buildState(params) {
  const issueMap = {};
  const issueOrder = [];
  for (const issue of params.issues) {
    issueOrder.push(issue.id);
    issueMap[issue.id] = {
      id: issue.id,
      title: issue.title,
      team: issue.team ?? null,
      order: issue.order,
      blockedBy: issue.blockedBy,
      externalBlockedBy: issue.externalBlockedBy ?? [],
      orchestrator: issue.orchestrator !== false,
      artifacts: issue.artifacts ?? {},
      status: "pending",
      attempts: 0,
      lastWorkerContextPath: null,
      lastFindingsPath: null,
      lastReviewPath: null,
      lastWorkerRun: null,
      workerRuns: [],
      managerReviews: [],
      commitSha: null,
      completedAt: null
    };
  }

  return {
    version: 1,
    slug: params.slug,
    sourcePath: params.sourcePath,
    status: "paused",
    pauseReason: "initialized; start daemon to begin execution",
    currentIssueId: null,
    baseBranch: params.baseBranch,
    managerBranch: params.managerBranch,
    maxAttemptsPerIssue: params.maxAttemptsPerIssue,
    selection: params.selection,
    issueOrder,
    issues: issueMap,
    project: params.project,
    artifacts: params.artifacts,
    startedAt: utcNow(),
    updatedAt: utcNow()
  };
}

function allIssues(state) {
  return (state.issueOrder ?? []).map((issueId) => state.issues[issueId]).filter(Boolean);
}

function allDone(state) {
  return allIssues(state).every((issue) => issue.status === "done");
}

function currentIssue(state) {
  return state.currentIssueId ? state.issues[state.currentIssueId] ?? null : null;
}

function unresolvedDependencies(state, issue) {
  return issue.blockedBy.filter((blockedIssueId) => state.issues[blockedIssueId]?.status !== "done");
}

function selectNextRunnableIssue(state) {
  return allIssues(state).find(
    (issue) =>
      ["pending", "needs-rework"].includes(issue.status) &&
      unresolvedDependencies(state, issue).length === 0 &&
      (issue.externalBlockedBy ?? []).length === 0
  );
}

function nextAttemptNumber(issue) {
  return Math.max(1, Number(issue.attempts ?? 0) + (issue.status === "needs-rework" ? 1 : 1));
}

function saveCurrentDigest(state) {
  const currentIssueId = state.currentIssueId ?? "none";
  const activeIssue = currentIssue(state);
  const next = graphNext(state);
  const lines = [
    `# Supervisor ${state.slug}`,
    "",
    `- Status: ${state.status}`,
    `- Pause reason: ${state.pauseReason ?? "none"}`,
    `- Base branch override: ${formatBaseBranchOverride(state.baseBranch)}`,
    `- Manager branch: ${state.managerBranch}`,
    `- Current issue: ${currentIssueId}`,
    `- Next action: ${next.action}`,
    `- Source path: ${state.sourcePath ?? "unknown"}`,
    `- Selected teams: ${(state.selection?.teams ?? []).join(", ") || "all"}`,
    `- Selected issue ids: ${(state.selection?.issueIds ?? []).join(", ") || "all"}`,
    `- Updated at: ${state.updatedAt}`,
    ""
  ];

  if (activeIssue) {
    lines.push(
      "## Current Issue",
      "",
      `- ${activeIssue.id} — ${activeIssue.title}`,
      `- Status: ${activeIssue.status}`,
      `- Attempts: ${String(activeIssue.attempts)}`,
      `- Last worker context: ${activeIssue.lastWorkerContextPath ?? "none"}`,
      `- Last findings: ${activeIssue.lastFindingsPath ?? "none"}`,
      `- Last review: ${activeIssue.lastReviewPath ?? "none"}`,
      ""
    );
  }

  lines.push("## Issue Order", "");
  for (const issue of allIssues(state)) {
    lines.push(
      `- ${issue.id} | status=${issue.status} | blockedBy=${issue.blockedBy.join(",") || "none"} | externalBlockedBy=${
        issue.externalBlockedBy.join(",") || "none"
      }`
    );
  }

  const targetPath = currentPath(state.slug);
  ensureDir(path.dirname(targetPath));
  fs.writeFileSync(targetPath, `${lines.join("\n")}\n`, "utf8");
}

function saveState(state) {
  state.updatedAt = utcNow();
  writeJson(slugStatePath(state.slug), state);
  saveCurrentDigest(state);
}

function graphNext(state) {
  if (state.status === "paused") {
    return {
      step: "paused",
      action: "wait_resume",
      issue: state.currentIssueId,
      reason: state.pauseReason
    };
  }

  if (["failed", "aborted"].includes(state.status)) {
    return {
      step: "terminal",
      action: "stop",
      issue: state.currentIssueId,
      status: state.status
    };
  }

  if (state.status === "done" || allDone(state)) {
    return {
      step: "flow_complete",
      action: "flow_complete",
      issue: null,
      status: "done"
    };
  }

  const issue = currentIssue(state) ?? selectNextRunnableIssue(state);
  if (!issue) {
    return {
      step: "blocked",
      action: "wait_dependencies",
      issue: null,
      blocked: allIssues(state)
        .filter((entry) => ["pending", "needs-rework"].includes(entry.status))
        .map((entry) => ({
          issue: entry.id,
          blockedBy: unresolvedDependencies(state, entry),
          externalBlockedBy: entry.externalBlockedBy ?? []
        }))
    };
  }

  const attempt = nextAttemptNumber(issue);

  if (issue.status === "pending") {
    return {
      step: "pending",
      action: "launch_worker",
      issue: issue.id,
      attempt,
      contextPath: normalizePath(path.relative(repoRoot(), workerContextPath(state.slug, issue.id, attempt)))
    };
  }

  if (issue.status === "needs-rework") {
    if (issue.attempts >= state.maxAttemptsPerIssue) {
      return {
        step: "blocked",
        action: "escalate_max_attempts",
        issue: issue.id,
        attempts: issue.attempts,
        maxAttempts: state.maxAttemptsPerIssue,
        findingsPath: issue.lastFindingsPath
      };
    }
    return {
      step: "pending",
      action: "launch_worker",
      issue: issue.id,
      attempt,
      findingsPath: issue.lastFindingsPath,
      contextPath: normalizePath(path.relative(repoRoot(), workerContextPath(state.slug, issue.id, attempt)))
    };
  }

  if (issue.status === "worker-running") {
    return {
      step: "waiting_worker",
      action: "wait_worker",
      issue: issue.id,
      lastWorkerRun: issue.lastWorkerRun
    };
  }

  if (issue.status === "worker-completed") {
    return {
      step: "manager_review",
      action: "run_manager_review",
      issue: issue.id,
      reviewPath: normalizePath(path.relative(repoRoot(), reviewPath(state.slug, issue.id, Math.max(1, issue.attempts)))),
      orchestratorRunPath: orchestratorRunPath(issue.id),
      planPath: openSpecChangePath(issue.id),
      progressPath: localProgressPath(issue.id)
    };
  }

  if (issue.status === "manager-accepted") {
    return {
      step: "finalize",
      action: "finalize_issue",
      issue: issue.id,
      commitSha: issue.commitSha
    };
  }

  return {
    step: "unknown",
    action: "stop",
    issue: issue.id,
    status: issue.status
  };
}

function loadSourceFromArgs(args, slug) {
  const sourcePath = path.resolve(
    getOption(
      args,
      "--source",
      getOption(args, "--manifest", path.join(repoRoot(), ".ai", "runtime", "supervisor", "imports", `${slug}.json`))
    )
  );
  const source = readJson(sourcePath, null);
  if (!source) {
    throw new Error(`missing supervisor source: ${sourcePath}`);
  }
  return { sourcePath, source };
}

function initFromSource(args, label) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const { sourcePath, source } = loadSourceFromArgs(args, slug);
  const manifest = parseIssueManifest(source, slug, sourcePath);
  const selection = selectIssues(manifest, {
    teams: getMultiOptionValues(args, "--team"),
    issueIds: getMultiOptionValues(args, "--issue")
  });

  const state = buildState({
    slug,
    sourcePath: normalizePath(path.relative(repoRoot(), sourcePath)),
    baseBranch: normalizeOptionalString(getOption(args, "--base-branch", manifest.baseBranch)),
    managerBranch: getOption(args, "--manager-branch", manifest.managerBranch),
    maxAttemptsPerIssue: Number.parseInt(
      getOption(args, "--max-attempts", String(manifest.maxAttemptsPerIssue ?? DEFAULT_MAX_ATTEMPTS)),
      10
    ),
    selection,
    issues: selection.issues,
    project: manifest.project,
    artifacts: manifest.artifacts
  });
  saveState(state);
  appendEvent(slug, { type: label, sourcePath: state.sourcePath, issueCount: state.issueOrder.length });
  process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
}

function commandInitFromManifest(args) {
  initFromSource(args, "init_from_manifest");
}

function commandInitFromLinear(args) {
  initFromSource(args, "init_from_linear");
}

function commandStatus(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  process.stdout.write(`${JSON.stringify(requireState(slug), null, 2)}\n`);
}

function commandPause(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const reason = getOption(args, "--reason", "paused by user");
  const state = requireState(slug);
  state.status = "paused";
  state.pauseReason = reason;
  saveState(state);
  appendEvent(slug, { type: "pause", reason });
  process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
}

function commandResume(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const state = requireState(slug);
  if (["done", "failed", "aborted"].includes(state.status)) {
    throw new Error(`cannot resume supervisor in status ${state.status}`);
  }
  state.status = "running";
  state.pauseReason = null;
  saveState(state);
  appendEvent(slug, { type: "resume" });
  process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
}

function commandAbort(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const reason = getOption(args, "--reason", "aborted by user");
  const state = requireState(slug);
  state.status = "aborted";
  state.pauseReason = reason;
  saveState(state);
  appendEvent(slug, { type: "abort", reason });
  process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
}

function commandGraphNext(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  process.stdout.write(`${JSON.stringify(graphNext(requireState(slug)), null, 2)}\n`);
}

function commandWriteWorkerContext(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const state = requireState(slug);
  const next = graphNext(state);
  if (next.action !== "launch_worker" || !next.issue) {
    throw new Error(`cannot write worker context in action ${next.action}`);
  }
  const issue = state.issues[next.issue];
  const attempt = Number(next.attempt ?? nextAttemptNumber(issue));
  const targetPath = workerContextPath(slug, issue.id, attempt);
  const lines = [
    `# Supervisor Worker Context: ${issue.id}`,
    "",
    `- Supervisor slug: ${slug}`,
    `- Issue: ${issue.id}`,
    `- Title: ${issue.title}`,
    `- Attempt: ${String(attempt)}`,
    `- Base branch: ${state.baseBranch}`,
    `- Manager branch: ${state.managerBranch}`,
    `- Orchestrator run path: ${orchestratorRunPath(issue.id)}`,
    `- OpenSpec change: ${openSpecChangePath(issue.id)}`,
    `- Progress path: ${localProgressPath(issue.id)}`,
    issue.lastFindingsPath ? `- Rework findings: ${issue.lastFindingsPath}` : "- Rework findings: none",
    "",
    "## Required behavior",
    "",
    "- Handle this issue only.",
    "- Use the orchestrator flow to do the implementation in an isolated worktree.",
    "- Return structured result to the launcher host.",
    "- Do not modify manager-branch product code directly.",
    "",
    "## Result contract",
    "",
    "- On success return JSON with `status: completed` and optional `worktreePath`, `summary`, `commitSha`.",
    "- On failure return JSON with `status: failed` and `summary`.",
    "- The daemon records state transitions; the worker should not mutate supervisor runtime state directly."
  ];
  ensureDir(path.dirname(targetPath));
  fs.writeFileSync(targetPath, `${lines.join("\n")}\n`, "utf8");
  issue.lastWorkerContextPath = normalizePath(path.relative(repoRoot(), targetPath));
  state.currentIssueId = issue.id;
  saveState(state);
  appendEvent(slug, { type: "write_worker_context", issue: issue.id, attempt, contextPath: issue.lastWorkerContextPath });
  process.stdout.write(
    `${JSON.stringify({ issue: issue.id, attempt, contextPath: issue.lastWorkerContextPath }, null, 2)}\n`
  );
}

function ensureIssueBound(state, issueId) {
  const issue = state.issues?.[issueId] ?? null;
  if (!issue) {
    throw new Error(`issue ${issueId} does not belong to supervisor ${state.slug}`);
  }
  return issue;
}

function commandRecordWorker(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const issueId = requireOption(args, "--issue");
  const status = requireOption(args, "--status");
  const runId = getOption(args, "--run-id", `${issueId}-${utcNow()}`);
  const worktreePath = getOption(args, "--worktree-path", null);
  const summary = getOption(args, "--summary", null);
  const commitSha = getOption(args, "--commit-sha", null);
  const state = requireState(slug);
  const issue = ensureIssueBound(state, issueId);

  if (status === "launched") {
    if (!["pending", "needs-rework"].includes(issue.status)) {
      throw new Error(`cannot launch worker for ${issueId} in status ${issue.status}`);
    }
    issue.attempts = Number(issue.attempts ?? 0) + 1;
    issue.status = "worker-running";
    issue.lastWorkerRun = {
      runId,
      status: "running",
      worktreePath,
      summary,
      commitSha,
      startedAt: utcNow(),
      updatedAt: utcNow()
    };
    issue.workerRuns.push(issue.lastWorkerRun);
    state.currentIssueId = issueId;
    saveState(state);
    appendEvent(slug, { type: "record_worker", issue: issueId, status, runId, worktreePath, summary, commitSha });
    process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
    return;
  }

  if (issue.status !== "worker-running") {
    throw new Error(`cannot record worker ${status} for ${issueId} in status ${issue.status}`);
  }

  if (issue.lastWorkerRun) {
    issue.lastWorkerRun.status = status;
    issue.lastWorkerRun.updatedAt = utcNow();
    if (worktreePath) {
      issue.lastWorkerRun.worktreePath = worktreePath;
    }
    if (summary) {
      issue.lastWorkerRun.summary = summary;
    }
    if (commitSha) {
      issue.lastWorkerRun.commitSha = commitSha;
    }
    if (status === "completed") {
      issue.lastWorkerRun.completedAt = utcNow();
    }
    if (status === "failed") {
      issue.lastWorkerRun.failedAt = utcNow();
    }
  }

  if (status === "completed") {
    issue.status = "worker-completed";
  } else if (status === "failed") {
    issue.status = issue.attempts >= state.maxAttemptsPerIssue ? "failed" : "needs-rework";
    if (issue.status === "failed") {
      state.status = "failed";
    }
  } else {
    throw new Error(`unsupported worker status: ${status}`);
  }

  state.currentIssueId = issueId;
  saveState(state);
  appendEvent(slug, { type: "record_worker", issue: issueId, status, runId, worktreePath, summary, commitSha });
  process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
}

function commandWriteFindingsStub(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const issueId = requireOption(args, "--issue");
  const state = requireState(slug);
  const issue = ensureIssueBound(state, issueId);
  const attempt = Math.max(1, Number(issue.attempts ?? 0));
  const targetPath = issueFindingsPath(slug, issueId, attempt);
  const lines = [
    `# Findings for ${issueId}`,
    "",
    "- Fill this file with concrete manager findings before recording `rework`.",
    `- Supervisor slug: ${slug}`,
    `- Attempt: ${String(attempt)}`
  ];
  ensureDir(path.dirname(targetPath));
  fs.writeFileSync(targetPath, `${lines.join("\n")}\n`, "utf8");
  issue.lastFindingsPath = normalizePath(path.relative(repoRoot(), targetPath));
  saveState(state);
  appendEvent(slug, { type: "write_findings_stub", issue: issueId, findingsPath: issue.lastFindingsPath });
  process.stdout.write(`${JSON.stringify({ issue: issueId, findingsPath: issue.lastFindingsPath }, null, 2)}\n`);
}

function commandRecordReview(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const issueId = requireOption(args, "--issue");
  const result = requireOption(args, "--result");
  const reviewPathInput = getOption(args, "--review-path", null);
  const findingsPath = getOption(args, "--findings-path", null);
  const summary = getOption(args, "--summary", null);
  const commitSha = getOption(args, "--commit-sha", null);
  const state = requireState(slug);
  const issue = ensureIssueBound(state, issueId);

  if (issue.status !== "worker-completed") {
    throw new Error(`cannot record manager review for ${issueId} in status ${issue.status}`);
  }

  const attempt = Math.max(1, Number(issue.attempts ?? 0));
  const normalizedReviewPath =
    reviewPathInput ??
    normalizePath(path.relative(repoRoot(), reviewPath(slug, issueId, attempt)));
  issue.lastReviewPath = normalizedReviewPath;
  issue.managerReviews.push({
    attempt,
    result,
    summary,
    findingsPath,
    reviewPath: normalizedReviewPath,
    commitSha,
    recordedAt: utcNow()
  });

  if (result === "accept") {
    issue.status = "manager-accepted";
    issue.commitSha = commitSha;
  } else if (result === "rework") {
    issue.status = "needs-rework";
    issue.lastFindingsPath = findingsPath;
  } else {
    throw new Error(`unsupported review result: ${result}`);
  }

  state.currentIssueId = issueId;
  saveState(state);
  appendEvent(slug, { type: "record_review", issue: issueId, result, findingsPath, reviewPath: normalizedReviewPath, summary, commitSha });
  process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
}

function commandMarkIssueDone(args) {
  ensureStateDirs();
  const slug = requireOption(args, "--slug");
  const issueId = requireOption(args, "--issue");
  const commitSha = getOption(args, "--commit-sha", null);
  const state = requireState(slug);
  const issue = ensureIssueBound(state, issueId);
  if (issue.status !== "manager-accepted") {
    throw new Error(`cannot mark ${issueId} done in status ${issue.status}; manager acceptance required`);
  }
  issue.status = "done";
  issue.commitSha = commitSha ?? issue.commitSha;
  issue.completedAt = utcNow();
  state.currentIssueId = null;
  if (allDone(state)) {
    state.status = "done";
  }
  saveState(state);
  appendEvent(slug, { type: "mark_issue_done", issue: issueId, commitSha: issue.commitSha });
  process.stdout.write(`${JSON.stringify(state, null, 2)}\n`);
}

function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  switch (command) {
    case "init-from-manifest":
      commandInitFromManifest(args);
      return;
    case "init-from-linear":
      commandInitFromLinear(args);
      return;
    case "status":
      commandStatus(args);
      return;
    case "pause":
      commandPause(args);
      return;
    case "resume":
      commandResume(args);
      return;
    case "abort":
      commandAbort(args);
      return;
    case "graph":
      if (args[1] !== "next") {
        throw new Error(`unknown supervisor graph command: ${String(args[1] ?? "")}`);
      }
      commandGraphNext(args.slice(1));
      return;
    case "write-worker-context":
      commandWriteWorkerContext(args);
      return;
    case "record-worker":
      commandRecordWorker(args);
      return;
    case "write-findings-stub":
      commandWriteFindingsStub(args);
      return;
    case "record-review":
      commandRecordReview(args);
      return;
    case "mark-issue-done":
      commandMarkIssueDone(args);
      return;
    default:
      throw new Error(`unknown supervisor command: ${String(command ?? "")}`);
  }
}

main();
