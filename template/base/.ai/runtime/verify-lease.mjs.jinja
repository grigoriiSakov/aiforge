import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import process from "node:process";
import { spawn } from "node:child_process";

const LOCK_DIR = path.join(os.tmpdir(), "aiforge-full-verify.lock");
const OWNER_PATH = path.join(LOCK_DIR, "owner.json");
const DEFAULT_TIMEOUT_SECONDS = 7200;
const POLL_INTERVAL_MS = 1000;

function usage() {
  console.error("Usage: node .ai/runtime/verify-lease.mjs run -- <command> [args...]");
  process.exit(2);
}

function timeoutMilliseconds() {
  const raw = process.env.AIFORGE_VERIFY_LOCK_TIMEOUT_SECONDS;
  if (!raw) return DEFAULT_TIMEOUT_SECONDS * 1000;
  const seconds = Number(raw);
  if (!Number.isFinite(seconds) || seconds <= 0) {
    throw new Error("AIFORGE_VERIFY_LOCK_TIMEOUT_SECONDS must be a positive number");
  }
  return seconds * 1000;
}

function readOwner() {
  try {
    return JSON.parse(fs.readFileSync(OWNER_PATH, "utf8"));
  } catch {
    return null;
  }
}

function processIsAlive(pid) {
  if (!Number.isInteger(pid) || pid <= 0) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error?.code === "EPERM";
  }
}

function delay(milliseconds) {
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

async function acquireLease(token) {
  const deadline = Date.now() + timeoutMilliseconds();
  while (true) {
    try {
      fs.mkdirSync(LOCK_DIR);
      fs.writeFileSync(
        OWNER_PATH,
        `${JSON.stringify({ pid: process.pid, token, cwd: process.cwd(), acquiredAt: new Date().toISOString() }, null, 2)}\n`
      );
      return;
    } catch (error) {
      if (error?.code !== "EEXIST") throw error;
    }

    const owner = readOwner();
    if (owner && !processIsAlive(owner.pid)) {
      fs.rmSync(LOCK_DIR, { recursive: true, force: true });
      continue;
    }
    if (!owner) {
      const ageMs = Date.now() - fs.statSync(LOCK_DIR).mtimeMs;
      if (ageMs > 30_000) {
        fs.rmSync(LOCK_DIR, { recursive: true, force: true });
        continue;
      }
    }
    if (Date.now() >= deadline) {
      const ownerLabel = owner?.pid ? `pid=${owner.pid} cwd=${owner.cwd ?? "unknown"}` : "unknown owner";
      throw new Error(`Timed out waiting for the host-wide full verify lease (${ownerLabel})`);
    }
    await delay(POLL_INTERVAL_MS);
  }
}

function releaseLease(token) {
  const owner = readOwner();
  if (owner?.token === token) {
    fs.rmSync(LOCK_DIR, { recursive: true, force: true });
  }
}

const [action, separator, command, ...args] = process.argv.slice(2);
if (action !== "run" || separator !== "--" || !command) usage();

const token = `${process.pid}-${Date.now()}-${Math.random().toString(16).slice(2)}`;
await acquireLease(token);

let child;
let receivedSignal = null;
const forwardSignal = (signal) => {
  receivedSignal = signal;
  if (child && !child.killed) child.kill(signal);
};
process.once("SIGINT", () => forwardSignal("SIGINT"));
process.once("SIGTERM", () => forwardSignal("SIGTERM"));

try {
  child = spawn(command, args, {
    cwd: process.cwd(),
    env: { ...process.env, AIFORGE_VERIFY_LEASE_HELD: "1" },
    stdio: "inherit"
  });
  const result = await new Promise((resolve, reject) => {
    child.once("error", reject);
    child.once("exit", (code, signal) => resolve({ code, signal }));
  });
  const signal = result.signal ?? receivedSignal;
  process.exitCode = signal === "SIGINT" ? 130 : signal === "SIGTERM" ? 143 : (result.code ?? 1);
} finally {
  releaseLease(token);
}
