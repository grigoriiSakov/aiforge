#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";

function readManifest() {
  const manifestPath = path.join(process.cwd(), ".ai", "project.manifest.json");
  if (!fs.existsSync(manifestPath)) {
    return null;
  }
  return JSON.parse(fs.readFileSync(manifestPath, "utf8"));
}

function readJson(filePath) {
  if (!fs.existsSync(filePath)) {
    return null;
  }
  try {
    return JSON.parse(fs.readFileSync(filePath, "utf8"));
  } catch {
    return null;
  }
}

function normalizePath(input) {
  return String(input ?? "")
    .replaceAll("\\", "/")
    .replace(/\/+/g, "/")
    .replace(/\/$/, "");
}

function currentBranch() {
  const result = spawnSync("git", ["rev-parse", "--abbrev-ref", "HEAD"], {
    cwd: process.cwd(),
    encoding: "utf8"
  });
  return result.status === 0 ? result.stdout.trim() : null;
}

function isRunBoundToCurrentContext(run, branchName) {
  const cwd = normalizePath(process.cwd());
  const worktreePath = normalizePath(run.worktreePath);
  if (worktreePath && (cwd === worktreePath || cwd.startsWith(`${worktreePath}/`))) {
    return true;
  }
  return Boolean(branchName && run.branch && branchName === String(run.branch));
}

function getCurrentSupervisorSummary() {
  const runsRoot = path.join(process.cwd(), ".ai", "runtime", "supervisor", "runs");
  if (!fs.existsSync(runsRoot)) {
    return null;
  }

  const branchName = currentBranch();
  if (!branchName) {
    return null;
  }

  for (const entry of fs.readdirSync(runsRoot)) {
    if (!entry.endsWith(".json")) {
      continue;
    }
    const run = readJson(path.join(runsRoot, entry));
    if (!run || !["running", "paused"].includes(String(run.status ?? ""))) {
      continue;
    }
    if (branchName !== String(run.managerBranch ?? "")) {
      continue;
    }

    const currentIssueId = run.currentIssueId ?? "none";
    const currentIssue = currentIssueId !== "none" ? run.issues?.[currentIssueId] : null;
    const nextAction =
      currentIssue?.status === "worker-running"
        ? "wait_worker"
        : currentIssue?.status === "worker-completed"
          ? "run_manager_review"
          : currentIssue?.status === "manager-accepted"
            ? "finalize_issue"
            : "launch_worker";
    return `${run.slug}:${run.status}:${currentIssueId}:${nextAction}`;
  }

  return null;
}

function getCurrentOrchestratorSummary() {
  const registryPath = path.join(process.cwd(), ".ai", "runtime", "orchestrator", "registry.json");
  const runsDir = path.join(process.cwd(), ".ai", "runtime", "orchestrator", "runs");
  const registry = readJson(registryPath);
  if (!registry) {
    return null;
  }

  const activeStatuses = new Set(["reserved", "building", "testing", "fix-loop", "reviewing"]);
  const branchName = currentBranch();
  const orderedIssueIds = [...Object.keys(registry.activeReservations ?? {}), ...Object.keys(registry.runs ?? {})];

  for (const issueId of orderedIssueIds) {
    const run = readJson(path.join(runsDir, `${issueId}.json`));
    if (!run || !activeStatuses.has(run.status) || !isRunBoundToCurrentContext(run, branchName)) {
      continue;
    }

    const nextAction =
      run.status === "reserved" && !run.worktreePath
        ? "start_worktree"
        : run.status === "reviewing"
          ? "run_review"
          : "run_build";

    return `${run.issueId}:${run.status}:${nextAction}`;
  }

  return null;
}

const manifest = readManifest();

if (!manifest) {
  process.stdout.write(`${JSON.stringify({ continue: true }, null, 2)}\n`);
  process.exit(0);
}

const additionalContext = [
  `Project: ${manifest.project.name}`,
  `Profile: ${manifest.profile.id}`,
  `Tracker: ${manifest.workflow.tracker}`,
  `Canonical verify task: ${manifest.task.command} ${manifest.task.tasks.verify}`,
  getCurrentSupervisorSummary() ? `Active supervisor: ${getCurrentSupervisorSummary()}` : "Active supervisor: none",
  getCurrentOrchestratorSummary()
    ? `Active orchestrator run: ${getCurrentOrchestratorSummary()}`
    : "Active orchestrator run: none"
].join(" ");

process.stdout.write(
  `${JSON.stringify(
    {
      continue: true,
      hookSpecificOutput: {
        hookEventName: "SessionStart",
        additionalContext
      }
    },
    null,
    2
  )}\n`
);
