#!/usr/bin/env node

function respond(payload, exitCode = 0) {
  process.stdout.write(`${JSON.stringify(payload, null, 2)}\n`);
  process.exit(exitCode);
}

function extractCommand(payload) {
  try {
    const parsed = payload ? JSON.parse(payload) : {};
    return String(
      parsed.command ??
        parsed.shellCommand ??
        parsed.tool_input?.command ??
        parsed.input ??
        payload
    );
  } catch {
    return payload;
  }
}

let raw = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => {
  raw += chunk;
});

process.stdin.on("end", () => {
  const payload = raw.trim();
  const command = extractCommand(payload);

  const blockedPatterns = [
    /\bgit\s+reset\s+--hard\b/,
    /\bgit\s+checkout\s+--\b/,
    /\brm\s+-rf\s+\/($|\s)/,
    /\bdel\s+\/f\s+\/q\b/i
  ];

  const matched = blockedPatterns.some((pattern) => pattern.test(command));
  if (matched) {
    respond(
      {
        permission: "deny",
        user_message: "Blocked by aiforge Cursor hook: destructive command detected.",
        agent_message: "Use a safer non-destructive command or ask for an explicit remediation path."
      },
      2
    );
  }

  respond({ permission: "allow" });
});

process.stdin.on("error", () => {
  respond({ permission: "allow" });
});
