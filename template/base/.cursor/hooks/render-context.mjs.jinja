#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";

const [, , eventName = "manual", eventFilePath = ""] = process.argv;
const projectDir = process.cwd();
const manifestPath = path.join(projectDir, ".ai", "project.manifest.json");
const taskStatePath = path.join(projectDir, ".ai", "runtime", "task-state.json");
const reviewStatePath = path.join(projectDir, ".ai", "runtime", "review-verdict.json");
const orchestratorRegistryPath = path.join(projectDir, ".ai", "runtime", "orchestrator", "registry.json");
const orchestratorRunsDir = path.join(projectDir, ".ai", "runtime", "orchestrator", "runs");
const supervisorRunsDir = path.join(projectDir, ".ai", "runtime", "initiative-supervisor", "runs");
const contextDir = path.join(projectDir, ".ai", "context");
const currentPath = path.join(contextDir, "current.md");

function readJson(filePath) {
  if (!fs.existsSync(filePath)) {
    return null;
  }

  try {
    return JSON.parse(fs.readFileSync(filePath, "utf8"));
  } catch {
    return null;
  }
}

function loadEvent(filePath) {
  if (!filePath || !fs.existsSync(filePath)) {
    return null;
  }

  try {
    return JSON.parse(fs.readFileSync(filePath, "utf8"));
  } catch {
    return {
      raw: fs.readFileSync(filePath, "utf8")
    };
  }
}

function loadRun(issueId) {
  return readJson(path.join(orchestratorRunsDir, `${issueId}.json`));
}

function normalizePath(input) {
  return String(input ?? "")
    .replaceAll("\\", "/")
    .replace(/\/+/g, "/")
    .replace(/\/$/, "");
}

function currentBranch() {
  const result = spawnSync("git", ["rev-parse", "--abbrev-ref", "HEAD"], {
    cwd: process.cwd(),
    encoding: "utf8"
  });
  return result.status === 0 ? result.stdout.trim() : null;
}

function isRunBoundToCurrentContext(run, branchName) {
  const cwd = normalizePath(process.cwd());
  const worktreePath = normalizePath(run.worktreePath);
  if (worktreePath && (cwd === worktreePath || cwd.startsWith(`${worktreePath}/`))) {
    return true;
  }
  return Boolean(branchName && run.branch && branchName === String(run.branch));
}

function getCurrentOrchestratorRun() {
  const registry = readJson(orchestratorRegistryPath);
  if (!registry) {
    return null;
  }

  const activeStatuses = new Set(["reserved", "building", "testing", "fix-loop", "reviewing"]);
  const branchName = currentBranch();
  const orderedIssueIds = [
    ...Object.keys(registry.activeReservations ?? {}),
    ...Object.keys(registry.runs ?? {})
  ];

  for (const issueId of orderedIssueIds) {
    const run = loadRun(issueId);
    if (!run || !activeStatuses.has(run.status) || !isRunBoundToCurrentContext(run, branchName)) {
      continue;
    }
    return run;
  }

  return null;
}

function getCurrentSupervisorRun() {
  if (!fs.existsSync(supervisorRunsDir)) {
    return null;
  }

  const branchName = currentBranch();
  if (!branchName) {
    return null;
  }

  for (const entry of fs.readdirSync(supervisorRunsDir)) {
    if (!entry.endsWith(".json")) {
      continue;
    }
    const run = readJson(path.join(supervisorRunsDir, entry));
    if (!run || !["running", "paused"].includes(String(run.status ?? ""))) {
      continue;
    }
    if (branchName !== String(run.managerBranch ?? "")) {
      continue;
    }
    return run;
  }

  return null;
}

function nextActionForRun(run) {
  if (!run) {
    return "none";
  }
  if (run.status === "reserved" && !run.worktreePath) {
    return "start_worktree";
  }
  if (run.status === "reviewing") {
    return "run_review";
  }
  return "run_build";
}

const manifest = readJson(manifestPath);
if (!manifest) {
  process.exit(0);
}

const taskState = readJson(taskStatePath) ?? { history: [] };
const reviewState = readJson(reviewStatePath);
const orchestratorRun = getCurrentOrchestratorRun();
const supervisorRun = getCurrentSupervisorRun();
const eventPayload = loadEvent(eventFilePath);
const recentTasks = Array.isArray(taskState.history) ? taskState.history.slice(-5).reverse() : [];
const llmsGlobs = Array.isArray(manifest.llms?.sourceGlobs) ? manifest.llms.sourceGlobs : [];
const notes = Array.isArray(manifest.commands?.verify) ? manifest.commands.verify : [];

const lines = [
  "# Current Context",
  "",
  `- Event: ${eventName}`,
  `- Updated: ${new Date().toISOString()}`,
  `- Project: ${manifest.project?.name ?? "unknown"}`,
  `- Profile: ${manifest.profile?.id ?? "unknown"}`,
  `- Tracker: ${manifest.workflow?.tracker ?? "unknown"}`,
  `- Main branch: ${manifest.project?.mainBranch ?? "unknown"}`,
  `- Verify task: ${manifest.task?.command ?? "task"} ${manifest.task?.tasks?.verify ?? "verify"}`,
  `- Review task: ${manifest.task?.command ?? "task"} ${manifest.task?.tasks?.review ?? "review"}`,
  `- Review verdict: ${reviewState?.status ?? "missing"}`,
  "",
  "## Initiative Supervisor",
  supervisorRun
    ? `- Slug: ${supervisorRun.slug}
- Status: ${supervisorRun.status}
- Manager branch: ${supervisorRun.managerBranch ?? "missing"}
- Current issue: ${supervisorRun.currentIssueId ?? "none"}
- Rule: manager must not edit product code in the main checkout; use isolated worker runs.`
    : "- No active initiative supervisor run.",
  "",
  "## Orchestrator",
  orchestratorRun
    ? `- Active issue: ${orchestratorRun.issueId}
- Status: ${orchestratorRun.status}
- Current step: ${orchestratorRun.currentStep ?? "unknown"}
- Worktree: ${orchestratorRun.worktreePath ?? "missing"}
- Next action: ${nextActionForRun(orchestratorRun)}
- Rule: do not stop until orchestrator reaches flow_complete.`
    : "- No active orchestrator run.",
  "",
  "## Recent Task Evidence",
  recentTasks.length > 0
    ? recentTasks.map((entry) => `- ${entry.timestamp} :: ${entry.stage} ${entry.taskName}`).join("\n")
    : "- No task evidence yet.",
  "",
  "## Verify Commands",
  notes.length > 0 ? notes.map((entry) => `- \`${entry}\``).join("\n") : "- No verify commands declared.",
  "",
  "## Source Globs",
  llmsGlobs.length > 0 ? llmsGlobs.map((entry) => `- \`${entry}\``).join("\n") : "- No source globs declared.",
  "",
  "## Last Hook Event",
  eventPayload ? `- ${JSON.stringify(eventPayload).slice(0, 500)}` : "- No event payload captured."
];

fs.mkdirSync(contextDir, { recursive: true });
fs.writeFileSync(currentPath, `${lines.join("\n")}\n`, "utf8");
