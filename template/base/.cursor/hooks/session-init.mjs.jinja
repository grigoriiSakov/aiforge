#!/usr/bin/env node

import { spawnSync } from "node:child_process";
import path from "node:path";

const renderContextPath = path.join(process.cwd(), ".cursor", "hooks", "render-context.mjs");

const result = spawnSync("node", [renderContextPath, "sessionStart"], {
  stdio: "inherit",
  cwd: process.cwd()
});

process.exit(result.status ?? 0);
