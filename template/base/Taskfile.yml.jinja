version: "3"

tasks:
  {{ task_implement_name }}:
    desc: Canonical implement task
    cmds:
      - node .ai/runtime/task-state.mjs pre {{ task_implement_name }}
{% for command in commands.implement %}
{% if '\n' in command %}
      - |
{{ command | indent(8, true) }}
{% else %}
      - {{ command }}
{% endif %}
{% endfor %}
      - node .ai/runtime/task-state.mjs post {{ task_implement_name }}

  {{ task_test_name }}:
    desc: Canonical test task
    cmds:
      - node .ai/runtime/task-state.mjs pre {{ task_test_name }}
{% for command in commands.test %}
{% if '\n' in command %}
      - |
{{ command | indent(8, true) }}
{% else %}
      - {{ command }}
{% endif %}
{% endfor %}
      - node .ai/runtime/task-state.mjs post {{ task_test_name }}

  {{ task_lint_name }}:
